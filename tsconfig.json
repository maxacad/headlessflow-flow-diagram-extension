{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": ["node", "vscode"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "src/DragBridge.ts"],
  "exclude": ["node_modules", "dist", "webview-src"],
  "references": [
    { "path": "./tsconfig.webview.json" }
  ]
}

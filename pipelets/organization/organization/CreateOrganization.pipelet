name: CreateOrganization
version: 1
trigger: manual
handler: ./CreateOrganization.ts
ai:
  skill: organization-createorganization
  title: CreateOrganization
  description: Intershop organization pipelet – CreateOrganization.
  tags: [integration, data]
  capabilities:
    - execute-organization-operation
inputs:
  DefaultOrganizationID: string
  DefaultOrganizationType: number
  Site: any
  Owner: any
  OrganizationID: string
  OrganizationType: number
outputs:
  Organization: any
steps:
  - type: function
    runtime: java
    function: com.intershop.component.organization.pipelet.organization.CreateOrganization

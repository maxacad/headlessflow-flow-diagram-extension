name: ResolveAccountTransactions
version: 1
trigger: manual
handler: ./ResolveAccountTransactions.ts
ai:
  skill: organization-resolveaccounttransactions
  title: ResolveAccountTransactions
  description: Intershop organization pipelet – ResolveAccountTransactions.
  tags: [account, balance, transaction]
  capabilities:
    - execute-account-operation
inputs:

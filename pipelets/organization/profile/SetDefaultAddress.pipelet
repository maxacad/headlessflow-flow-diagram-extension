name: SetDefaultAddress
version: 1
trigger: manual
handler: ./SetDefaultAddress.ts
ai:
  skill: organization-setdefaultaddress
  title: SetDefaultAddress
  description: Intershop organization pipelet – SetDefaultAddress.
  tags: [profile, address]
  capabilities:
    - execute-profile-operation
inputs:
  Profile: any
  Address: any
  DefaultAddress: string
  DefaultShipToAddress: string
  DefaultShipFromAddress: string
  DefaultInvoiceToAddress: string
  DefaultInstallToAddress: string
  DefaultServiceToAddress: string
steps:
  - type: function
    runtime: java
    function: com.intershop.component.organization.pipelet.profile.SetDefaultAddress

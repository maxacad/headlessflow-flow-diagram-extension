name: DeterminePasswordReminder
version: 1
trigger: manual
handler: ./DeterminePasswordReminder.ts
ai:
  skill: core-determinepasswordreminder
  title: DeterminePasswordReminder
  description: Intershop core pipelet – DeterminePasswordReminder.
  tags: [user, authentication, profile]
  capabilities:
    - execute-user-operation
inputs:
  CurrentDomain: any
  Login: string
outputs:
  PasswordReminder: string
  MailTo: string
  MailDomain: string
  ErrorUserHandling: string
  ERROR_User: string
steps:
  - type: function
    runtime: java
    function: com.intershop.beehive.core.pipelet.user.DeterminePasswordReminder

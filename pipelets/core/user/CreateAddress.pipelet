name: CreateAddress
version: 1
trigger: manual
handler: ./CreateAddress.ts
ai:
  skill: core-createaddress
  title: CreateAddress
  description: Intershop core pipelet – CreateAddress.
  tags: [user, authentication, profile]
  capabilities:
    - execute-user-operation
inputs:
  Profile: any
  AddressName: string
  Title: string
  FirstName: string
  SecondName: string
  LastName: string
  Suffix: string
  Company: string
  City: string
  State: string
  Street: string
  Street2: string
  PostalCode: string
  PhoneBusiness: string
  PhoneBusinessDirect: string
  PhoneHome: string
  Fax: string
  Mobile: string
  Email: string
  SecondLastName: string
  Honorific: string
  JobTitle: string
  FirstNameTranscription: string
  LastNameTranscription: string
  CompanyTranscription: string
  StreetTranscription: string
  ConfirmMail: string
  ConfirmFax: string
  AddressNr: string
  PostBox: string
  Province: string
  Prefecture: string
  County: string
  Region: string
  Country: string
  CountryCode: string
  Homepage: string
  UseForInvoiceTo: string
  UseForShipTo: string
  UseForServiceTo: string
  UseForInstallTo: string
  UseForShipFrom: string
  CustomAddressTypeCode: string
  Street3: string
  CompanyName2: string
outputs:
  Address: any
steps:
  - type: function
    runtime: java
    function: com.intershop.beehive.core.pipelet.user.CreateAddress

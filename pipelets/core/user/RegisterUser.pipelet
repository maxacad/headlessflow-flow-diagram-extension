name: RegisterUser
version: 1
trigger: manual
handler: ./RegisterUser.ts
ai:
  skill: core-registeruser
  title: RegisterUser
  description: Intershop core pipelet – RegisterUser.
  tags: [user, authentication, profile]
  capabilities:
    - execute-user-operation
inputs:
  CurrentUser: any
  CurrentDomain: any
  Login: string
  Password: string
  PasswordConfirmation: string
  LocaleID: string
  PasswordReminder: string
  Email: string
  Title: string
  FirstName: string
  SecondName: string
  LastName: string
  SecondLastName: string
  Company: string
  Honorific: string
  JobTitle: string
  Suffix: string
  FirstNameTranscription: string
  LastNameTranscription: string
  CompanyTranscription: string
  StreetTranscription: string
  ConfirmMail: string
  ConfirmFax: string
  AddressNr: string
  City: string
  State: string
  Street: string
  Street2: string
  PostalCode: string
  PostBox: string
  Province: string
  Prefecture: string
  County: string
  Region: string
  Country: string
  CountryCode: string
  PhoneBusiness: string
  PhoneBusinessDirect: string
  PhoneHome: string
  Fax: string
  Mobile: string
  Homepage: string
  BirthdayDate: any
  Birthday: string
  Gender: string
  UpdateDefaultAddress: string
  Description: string
  NickName: string
  CompanyName2: string
outputs:
  ERROR_User: string
  RegisteredUser: any
  ViolatedRuleDescription: string
steps:
  - type: function
    runtime: java
    function: com.intershop.beehive.core.pipelet.user.RegisterUser

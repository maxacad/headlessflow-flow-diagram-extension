name: VerifyCredential
version: 1
trigger: manual
handler: ./VerifyCredential.ts
ai:
  skill: core-verifycredential
  title: VerifyCredential
  description: Intershop core pipelet – VerifyCredential.
  tags: [user, authentication, profile]
  capabilities:
    - execute-user-operation
inputs:
  Login: string
  Password: string
  Domain: any
  CurrentLocale: any
  User: any
outputs:
  ViolatedRuleDescription: string
  ERROR_User: string
steps:
  - type: function
    runtime: java
    function: com.intershop.beehive.core.pipelet.user.VerifyCredential

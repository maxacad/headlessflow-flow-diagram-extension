name: GeneratePassword
version: 1
trigger: manual
handler: ./GeneratePassword.ts
ai:
  skill: core-generatepassword
  title: GeneratePassword
  description: Intershop core pipelet – GeneratePassword.
  tags: [user, authentication, profile]
  capabilities:
    - execute-user-operation
inputs:
  CurrentDomain: any
outputs:
  Password: string
  PasswordConfirmation: string
steps:
  - type: function
    runtime: java
    function: com.intershop.beehive.core.pipelet.user.GeneratePassword

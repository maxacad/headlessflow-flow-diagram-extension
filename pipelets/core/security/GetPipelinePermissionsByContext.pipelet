  PipelineName: string
  StartNodeName: string
  Context: string
  Application: any
outputs:
  PermissionIDs: iterator
steps:
  - type: function
    runtime: java
    function: com.intershop.beehive.core.pipelet.security.GetPipelinePermissionsByContext

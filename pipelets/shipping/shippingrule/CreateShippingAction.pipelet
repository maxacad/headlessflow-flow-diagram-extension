name: CreateShippingAction
version: 1
trigger: manual
handler: ./CreateShippingAction.ts
ai:
  skill: shipping-createshippingaction
  title: CreateShippingAction
  description: Intershop shipping pipelet – CreateShippingAction.
  tags: [shipping, rule, action]
  capabilities:
    - execute-shippingrule-operation
inputs:
  ShippingRule: any
outputs:
  ShippingAction: any
steps:
  - type: function
    runtime: java
    function: com.intershop.component.shipping.pipelet.shippingrule.CreateShippingAction

name: CreateShippingRule
version: 1
trigger: manual
handler: ./CreateShippingRule.ts
ai:
  skill: shipping-createshippingrule
  title: CreateShippingRule
  description: Intershop shipping pipelet – CreateShippingRule.
  tags: [shipping, rule, action]
  capabilities:
    - execute-shippingrule-operation
inputs:
  RuleId: string
outputs:
  ShippingRule: any
steps:
  - type: function
    runtime: java
    function: com.intershop.component.shipping.pipelet.shippingrule.CreateShippingRule

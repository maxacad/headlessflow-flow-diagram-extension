{
  "title": "User Registration",
  "type": "object",
  "displayType": "row",
  "labelWidth": 120,
  "properties": {
    "name": {
      "title": "Full Name",
      "type": "string",
      "required": true,
      "placeholder": "Enter your full name"
    },
    "email": {
      "title": "Email",
      "type": "string",
      "format": "email",
      "required": true,
      "placeholder": "your@email.com"
    },
    "age": {
      "title": "Age",
      "type": "number",
      "minimum": 0,
      "maximum": 120
    },
    "gender": {
      "title": "Gender",
      "type": "string",
      "enum": ["male", "female", "other"],
      "enumNames": ["Male", "Female", "Other"],
      "widget": "select",
      "placeholder": "Select gender"
    },
    "subscribe": {
      "title": "Subscribe to newsletter",
      "type": "boolean",
      "default": false
    },
    "bio": {
      "title": "Bio",
      "type": "string",
      "widget": "textarea",
      "placeholder": "Tell us about yourself",
      "props": {
        "rows": 4
      }
    }
  }
}

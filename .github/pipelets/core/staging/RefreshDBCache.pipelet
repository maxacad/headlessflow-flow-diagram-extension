  description: Intershop core pipelet – RefreshDBCache.
  tags: [staging, replication, publishing]
  capabilities:
    - execute-staging-operation
inputs:
  StagingProcess: any
  ChangedStagingTables: iterator
steps:
  - type: function
    runtime: java
    function: com.intershop.beehive.core.pipelet.staging.RefreshDBCache

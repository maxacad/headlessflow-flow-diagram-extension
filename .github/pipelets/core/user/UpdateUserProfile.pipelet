  description: Intershop core pipelet – UpdateUserProfile.
  tags: [user, authentication, profile]
  capabilities:
    - execute-user-operation
inputs:
  CurrentUser: any
  LocaleID: string
  OldPassword: string
  Password: string
  PasswordConfirmation: string
  PasswordReminder: string
  AddressNr: string
  PostBox: string
  Province: string
  Prefecture: string
  County: string
  Region: string
  Country: string
  CountryCode: string
  ConfirmMail: string
  ConfirmFax: string
  Title: string
  FirstName: string
  SecondName: string
  LastName: string
  SecondLastName: string
  Honorific: string
  JobTitle: string
  Suffix: string
  BirthdayDate: any
  Company: string
  City: string
  State: string
  Street: string
  Street2: string
  PostalCode: string
  PhoneBusiness: string
  PhoneBusinessDirect: string
  PhoneHome: string
  Fax: string
  Mobile: string
  Email: string
  Homepage: string
  FirstNameTranscription: string
  LastNameTranscription: string
  CompanyTranscription: string
  StreetTranscription: string
  Birthday: string
  Gender: string
  UpdateDefaultAddress: string
  Description: string
  NickName: string
  CompanyName2: string
steps:
  - type: function
    runtime: java
    function: com.intershop.beehive.core.pipelet.user.UpdateUserProfile

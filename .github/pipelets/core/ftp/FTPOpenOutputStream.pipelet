name: FTPOpenOutputStream
version: 1
trigger: manual
handler: ./FTPOpenOutputStream.ts
ai:
  skill: core-ftpopenoutputstream
  title: FTPOpenOutputStream
  description: Intershop core pipelet – FTPOpenOutputStream.
  tags: [integration, data]
  capabilities:
    - execute-ftp-operation
inputs:
  FTPClient: any
  ftp_file_name: string
  ftp_remote_directory: string
  ftp_mode: string
outputs:
  FTPOutputStream: any
steps:
  - type: function
    runtime: java
    function: com.intershop.beehive.core.pipelet.ftp.FTPOpenOutputStream

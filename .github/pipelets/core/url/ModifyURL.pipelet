name: ModifyURL
version: 1
trigger: manual
handler: ./ModifyURL.ts
ai:
  skill: core-modifyurl
  title: ModifyURL
  description: Intershop core pipelet – ModifyURL.
  tags: [integration, data]
  capabilities:
    - execute-url-operation
inputs:
  URLParameterHandling: string
  ServerGroup: string
  SiteName: string
  LocaleID: string
  CurrencyID: string
  PipelineName: string
  URLParameters: any
  TemplateSet: string
  StartNodeName: string
  PipelineDictionaryID: number
steps:
  - type: function
    runtime: java
    function: com.intershop.beehive.core.pipelet.url.ModifyURL

  description: Intershop organization pipelet – GetUserDelegations.
  tags: [user, authentication, profile]
  capabilities:
    - execute-user-operation
inputs:
  User: any
  DelegationType: string
  DefaultDelegationType: string
outputs:
  UserDelegations: iterator
steps:
  - type: function
    runtime: java
    function: com.intershop.component.organization.pipelet.user.GetUserDelegations

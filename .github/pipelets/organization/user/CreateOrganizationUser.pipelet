name: CreateOrganizationUser
version: 1
trigger: manual
handler: ./CreateOrganizationUser.ts
ai:
  skill: organization-createorganizationuser
  title: CreateOrganizationUser
  description: Intershop organization pipelet – CreateOrganizationUser.
  tags: [user, authentication, profile]
  capabilities:
    - execute-user-operation
inputs:
  Organization: any
  Login: string
  Password: string
  CreateDefaultAddress: string
outputs:
  User: any
  ERROR_User: string
  ViolatedRuleDescription: string
steps:
  - type: function
    runtime: java
    function: com.intershop.component.organization.pipelet.user.CreateOrganizationUser

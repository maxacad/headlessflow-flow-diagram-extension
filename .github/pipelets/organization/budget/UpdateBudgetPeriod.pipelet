  FromDate: any
  ToDate: any
  DefaultAmountValue: string
  DefaultAmountCurrency: string
  DefaultDateTimes: string
outputs:
  ErrorMessage: string
steps:
  - type: function
    runtime: java
    function: com.intershop.component.organization.pipelet.budget.UpdateBudgetPeriod

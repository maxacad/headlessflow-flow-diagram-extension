name: GetAccessibleDepartments
version: 1
trigger: manual
handler: ./GetAccessibleDepartments.ts
ai:
  skill: organization-getaccessibledepartments
  title: GetAccessibleDepartments
  description: Intershop organization pipelet – GetAccessibleDepartments.
  tags: [role, permission, access]
  capabilities:
    - execute-role-operation
inputs:
  User: any
  Organization: any
  MasterRoleID: string
outputs:
  Departments: iterator
  DepartmentMap: map
steps:
  - type: function
    runtime: java
    function: com.intershop.component.organization.pipelet.role.GetAccessibleDepartments

name: ActivateShippingRule
version: 1
trigger: manual
handler: ./ActivateShippingRule.ts
ai:
  skill: shipping-activateshippingrule
  title: ActivateShippingRule
  description: Intershop shipping pipelet – ActivateShippingRule.
  tags: [shipping, rule, action]
  capabilities:
    - execute-shippingrule-operation
inputs:
  Active: string
  ShippingRule: any
steps:
  - type: function
    runtime: java
    function: com.intershop.component.shipping.pipelet.shippingrule.ActivateShippingRule

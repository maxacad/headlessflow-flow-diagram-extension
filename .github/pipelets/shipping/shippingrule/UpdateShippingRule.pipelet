name: UpdateShippingRule
version: 1
trigger: manual
handler: ./UpdateShippingRule.ts
ai:
  skill: shipping-updateshippingrule
  title: UpdateShippingRule
  description: Intershop shipping pipelet – UpdateShippingRule.
  tags: [shipping, rule, action]
  capabilities:
    - execute-shippingrule-operation
inputs:
  Locale: any
  ShippingRule: any
  RuleName: string
  Description: string
steps:
  - type: function
    runtime: java
    function: com.intershop.component.shipping.pipelet.shippingrule.UpdateShippingRule

name: GetSortedShippingDestinationCountries
version: 1
trigger: manual
handler: ./GetSortedShippingDestinationCountries.ts
ai:
  skill: shipping-getsortedshippingdestinationcountries
  title: GetSortedShippingDestinationCountries

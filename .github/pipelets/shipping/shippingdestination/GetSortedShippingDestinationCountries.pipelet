  tags: [shipping, geography]
  capabilities:
    - execute-shippingdestination-operation
inputs:
  ShippingDestinationCountriesProvider: object
outputs:
  Countries: iterator
steps:
  - type: function
    runtime: java
    function: com.intershop.component.shipping.pipelet.shippingdestination.GetSortedShippingDestinationCountries
